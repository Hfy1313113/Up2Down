# ===== 根级 .gitignore =====

# --- 环境变量文件：只提交 .env.example，绝不提交真实 .env ---
.env
*.env.local

# --- 测试截图等产物 ---
shots/
shot_*.png

# --- 构建产物与依赖 ---
node_modules/
dist/
build/
.wrangler/
.dev.vars

# --- 日志与临时文件 ---
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器 / IDE ---
.vscode/
.idea/
*.swp

# --- 风格包的第三方音频文件由部署者自行放置，不入库（见 docs/ARCHITECTURE.md 风格包一节） ---
frontend/public/styles/*/music/*.mp3
frontend/public/styles/*/music/*.ogg
frontend/public/styles/*/music/*.wav
