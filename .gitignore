# ===== 根级 .gitignore =====

# --- 环境变量文件：只提交 .env.example，绝不提交真实 .env ---
.env
*.env.local

# --- 测试截图等产物 ---
shots/
shot_*.png

# --- 构建产物与依赖 ---
node_modules/
dist/
build/
.wrangler/
.dev.vars

# --- 日志与临时文件 ---
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器 / IDE ---
.vscode/
.idea/
*.swp
